[
  {
    "name": "Korean Resident Registration Number",
    "regular": "[^0-9]([0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])-?[1-4][0-9]{6})[^0-9]",
    "color": "red",
    "state": true
  },
  {
    "name": "Korean Foreign Registration Number",
    "regular": "[^0-9]([0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])-?[5-8][0-9]{6})[^0-9]",
    "color": "red",
    "state": true
  },
  {
    "name": "Korean Mobile Phone Number",
    "regular": "[^0-9]((?:01[016-9]|\\+?82[ -]?1[016-9])[ -]?[0-9]{3,4}[ -]?[0-9]{4})[^0-9]",
    "color": "orange",
    "state": true
  },
  {
    "name": "Korean Business Registration Number",
    "regular": "[^0-9]([0-9]{3}-[0-9]{2}-[0-9]{5})[^0-9]",
    "color": "orange",
    "state": true
  },
  {
    "name": "Korean Driver License Number",
    "regular": "[^0-9]([0-9]{2}-[0-9]{2}-[0-9]{6}-[0-9]{2})[^0-9]",
    "color": "orange",
    "state": true
  },
  {
    "name": "Korean Passport Number",
    "regular": "[^A-Za-z0-9]([MSRODmsrod][0-9]{8})[^A-Za-z0-9]",
    "color": "yellow",
    "state": false
  },
  {
    "name": "Toss Payments Secret Key",
    "regular": "(?:test|live)_(?:sk|ck)_[A-Za-z0-9]{20,}",
    "color": "red",
    "state": true
  },
  {
    "name": "Kakao REST API Key",
    "regular": "KakaoAK\\s+[0-9a-fA-F]{32}",
    "color": "red",
    "state": true
  }
]
